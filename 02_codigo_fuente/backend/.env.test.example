# Variables de docker-compose.test.yml (pruebas de INTEGRACIÓN, base efímera).
# Uso local:  cp .env.test.example .env.test   y reemplazar los valores por otros generados al azar.
# El archivo .env.test NO se sube al repositorio (está en .gitignore). Los valores de abajo son falsos.
# En el pipeline estos valores se generan en cada ejecución (openssl rand) y no se guardan en ningún lado.
#
# Usar valores NUEVOS y propios de pruebas: no reutilizar claves ni correos de ningún entorno real.
#   SECRET_KEY:        openssl rand -hex 32
#   POSTGRES_PASSWORD: openssl rand -hex 16      (solo letras y números: va dentro de una URL)
#   ADMIN_PASSWORD:    openssl rand -hex 12
# El nombre y el usuario de la base de pruebas están fijos en docker-compose.test.yml (yanacocha_test).

SECRET_KEY=EJEMPLO-no-usar-genera-una-con-openssl-rand-hex-32
POSTGRES_PASSWORD=EJEMPLO-no-usar-cambia-esta-clave
ADMIN_CORREO=admin.pruebas@pruebas-yanacocha.com
ADMIN_PASSWORD=EJEMPLO-no-usar-cambia-esta-clave

# Opcional: puerto del gateway en el host (solo escucha en 127.0.0.1)
# GATEWAY_PORT=8000
