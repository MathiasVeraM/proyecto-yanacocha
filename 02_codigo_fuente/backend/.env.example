# Variables de docker-compose.yml. Uso (opcional):  cp .env.example .env
# Este archivo NO sube al repositorio (.env está en .gitignore). Los valores de abajo son falsos.
#
# docker-compose.yml NO lee aquí la configuración de los servicios: cada uno usa su propio .env
# (gateway/.env, servicio_accesos/.env, servicio_gestion_animal/.env, servicio_actividades/.env;
# ver el .env.example de cada carpeta). DATABASE_URL y SECRET_KEY viven allí. La SECRET_KEY
# debe ser la misma en los cuatro.
#
# En esos .env las URLs entre servicios (ACCESSOS_SERVICE_URL, ACTIVIDADES_SERVICE_URL, ...) pueden
# seguir apuntando a localhost: dentro de Docker el compose las reemplaza por los nombres de los contenedores.

# --- Puerto del gateway (opcionales) ---
# GATEWAY_PORT=8000
# En el servidor, para aceptar conexiones que no sean de la propia máquina (por defecto solo 127.0.0.1):
# GATEWAY_BIND_ADDRESS=0.0.0.0

# --- Solo con docker-compose.local-db.yml (base PostgreSQL local y limpia, no la real) ---
# Usar solo letras y números (por ejemplo, openssl rand -hex 16): va dentro de una URL de conexión.
POSTGRES_PASSWORD=EJEMPLO-no-usar-cambia-esta-clave
# POSTGRES_DB=yanacocha_dev
# POSTGRES_USER=yanacocha
# El primer administrador se crea con ADMIN_CORREO y ADMIN_PASSWORD de servicio_accesos/.env
